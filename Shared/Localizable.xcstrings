            "value": "Warte auf die Freigabe im Browser …"
          }
        }
      }
    },
    "Warm-up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einlaufen"
          }
        }
      }
    },
    "Warm-up, cool-down and jog breaks have no target. On warm days (>25 °C) cap heart rate rather than chase pace.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf-/Auslaufen und Trabpausen ohne Ziel. An warmen Tagen (>25 °C) lieber die HF deckeln als die Pace jagen."
          }
        }
      }
    },
