// Signing and identifiers of Pace Lab.
//
// Do NOT enter your own values here, but in Config/Signing.local.xcconfig
// (template: Signing.local.example.xcconfig). This file is excluded from the
// repository via .gitignore.

// Team ID from developer.apple.com → Membership (even a free account
// has a "Personal Team"). Required so that the app and widgets can share data.
DEVELOPMENT_TEAM =

// Your own unique identifier, e.g. com.yourname.pacelab
PACELAB_BUNDLE_ID = com.example.pacelab

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development

// App group for data exchange with the widgets (team prefix, macOS).
PACELAB_APP_GROUP = $(DEVELOPMENT_TEAM).$(PACELAB_BUNDLE_ID)

#include? "Signing.local.xcconfig"
